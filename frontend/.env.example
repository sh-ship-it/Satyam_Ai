# Satyam frontend environment.
# Base URL of the Satyam FastAPI backend (our architecture).
#
# Prefer 127.0.0.1 over localhost on Windows. `localhost` resolves to ::1 first,
# and `uvicorn --host 0.0.0.0` binds IPv4 only, so the browser can fail to connect
# with a bare "Failed to fetch" while curl and PowerShell succeed (they fall back
# to IPv4; Chrome does not always). The literal address cannot be misresolved.
VITE_API_BASE_URL="http://127.0.0.1:8000"

# ── Google Photorealistic 3D Maps (the "STREET 3D" view on /vision) ──────────
#
# Optional. Leave BLANK and the STREET 3D button stays disabled with an inline
# explanation; every other Vision view keeps working. Nothing else in the app
# depends on it.
#
# IMPORTANT, and not a formality: a Google Maps JS key is loaded BY THE BROWSER.
# Vite inlines every VITE_* var into the client bundle, so this value is visible
# to anyone who opens the app — .gitignore keeps it out of the repository, it
# does NOT make it secret. The only real protection is server-side restriction
# in Google Cloud Console:
#   1. Application restrictions -> HTTP referrers -> allow only your own origins
#      (e.g. http://localhost:3000/*  and your deployed domain)
#   2. API restrictions -> allow only "Maps JavaScript API"
# Without those two, a key published in a bundle can be used by anyone and
# billed to you.
#
# Requires v=beta and libraries=maps3d; Photorealistic 3D Maps is not on the
# stable channel yet.
VITE_GOOGLE_MAPS_API_KEY=
