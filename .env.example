# ─────────────────────────────────────────────────────────────────────────────
# Satyam — root environment (shared by docker-compose)
# Copy to .env and fill in. Blank model keys => backend runs in DEMO_MODE
# (synthetic fixtures, deterministic stub models) so the stack boots with no
# external dependencies.
# ─────────────────────────────────────────────────────────────────────────────

# --- Postgres ---
POSTGRES_USER=satyam
POSTGRES_PASSWORD=satyam
POSTGRES_DB=satyam
POSTGRES_PORT=5432

# --- Backend ---
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://satyam:satyam@postgres:5432/satyam
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000

# --- Model adapter layer ---
# api | local
MODEL_BACKEND=api
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
BHASHINI_API_KEY=
BHASHINI_USER_ID=
EMBEDDING_DIM=1024

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
