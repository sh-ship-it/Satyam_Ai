# ─────────────────────────────────────────────────────────────────────────────
# Satyam — root environment (shared by docker-compose)
# Copy to .env and fill in. Blank model keys => backend runs in DEMO_MODE
# (synthetic fixtures, deterministic stub models) so the stack boots with no
# external dependencies.
# ─────────────────────────────────────────────────────────────────────────────

# --- Postgres ---
POSTGRES_USER=satyam
POSTGRES_PASSWORD=satyam
POSTGRES_DB=satyam
POSTGRES_PORT=5432

# --- Backend ---
APP_ENV=development
DATABASE_URL="use ur own "
LOCAL_DATABASE_URL="user ur own "
REDIS_URL="  "
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000

# --- Model adapter layer ---
# Overall compute plane: api | local
MODEL_BACKEND=api

# Brain engine (chat / slots / routing): gemini | groq
BRAIN_ENGINE=gemini

# Text-to-SQL engine: gemini | qwen3-coder-next
SQL_ENGINE=gemini

# Voice backend: sarvam | bhashini
VOICE_BACKEND=sarvam

# --- Gemini (primary brain + default SQL engine) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Groq (low-latency / outage fallback brain) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Sarvam (primary voice: Bulbul v3 TTS, Saaras v2 STT, Sarvam Translate) ---
# Free-tier credits are a one-time grant; pre-cache demo TTS to conserve them.
SARVAM_API_KEY=

# --- Bhashini (fallback voice: govt, free, no credit cap) ---
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# --- Ollama Cloud (qwen3-coder-next Text-to-SQL option) ---
# Free tier: light usage, 5-hour session + weekly resets, 1 concurrent model.
OLLAMA_CLOUD_URL=https://api.ollama.com
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_SQL_MODEL=qwen3-coder-next:cloud

# --- Embeddings (always BGE-M3 local — not configurable) ---
EMBEDDING_DIM=1024

# --- Remote model service (optional — HF Spaces / RunPod / any host) ---
# When set, the backend calls this URL for /embed and /rerank instead of
# loading the multi-GB sentence-transformers weights locally.
# Leave blank to use local inference (existing behaviour).
MODEL_SERVICE_URL=
MODEL_SERVICE_API_KEY=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

