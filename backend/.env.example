APP_ENV=development
# Runtime: least-privilege role so Postgres RLS is enforced (NOT the table owner).
DATABASE_URL=postgresql+asyncpg://satyam_app:satyam_app@localhost:5432/satyam
# Owner/superuser role - used ONLY for migrations + seeding.
SEED_DATABASE_URL=postgresql+asyncpg://satyam:satyam@localhost:5432/satyam
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000

MODEL_BACKEND=api
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
BHASHINI_API_KEY=
BHASHINI_USER_ID=
EMBEDDING_DIM=1024
