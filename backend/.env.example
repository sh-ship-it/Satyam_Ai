APP_ENV=development
# Runtime: least-privilege role so Postgres RLS is enforced (NOT the table owner).
DATABASE_URL="use ur own "
# Owner/superuser role - used ONLY for migrations + seeding.
SEED_DATABASE_URL="use ur own"
# Local Postgres URL — used when the Settings panel selects "local" database source.
# Defaults to satyam_app on localhost if not set.
LOCAL_DATABASE_URL="use ur own "
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000

# Response-Ops module (EMERGE-derived: predictive deployment, dispatch, green
# corridor, CCTV review). MUST be true or /api/ops/* and the Response Ops screen
# will NOT exist. This is the #1 reason the decided features were not showing.
ENABLE_RESPONSE_OPS=true

# Vision tactical map (/vision + /api/vision). MUST be true or the route and its
# API surface will not exist. This is also the kill switch: set it to false to
# remove Vision entirely without affecting any other screen.
# Vision reuses the ops layers for patrols/signals/cameras, so with
# ENABLE_RESPONSE_OPS=false it still renders crime density and risk zones and
# reports the live layers as degraded rather than showing them empty.
ENABLE_VISION=true

# ============================================================================
# DEPLOYMENT CHECKLIST (Zoho Catalyst AppSail + Neon)
# Each line below is a measured finding, not a precaution.
#
# 1. RLS IS BYPASSED WHEN THE APP CONNECTS AS THE TABLE OWNER.
#    Measured: as neondb_owner (rolbypassrls = true), `SELECT count(*) FROM cases`
#    returned every row both with NO jurisdiction context and with
#    scope=station. The RLS policies are correct; the role ignores them.
#    Applying migrations/011_ops_rls.sql is necessary but NOT sufficient, because
#    FORCE ROW LEVEL SECURITY constrains the owner but not a rolbypassrls role.
#    FIX (configuration only — the split already exists):
#      DATABASE_URL       -> a least-privilege role (satyam_app), NOT the owner
#      SEED_DATABASE_URL  -> neondb_owner, used only by migrations and seeding
#    Run migrations/008_local_app_grants.sql plus 011_ops_rls.sql once against
#    Neon so the role has its grants. Verify with:
#      SELECT count(*) FROM cases;   -- expect 0 with no app.* GUCs set
#    Until this is done, jurisdiction scoping exists in Python only, and
#    /api/vision/telemetry will report rls_enforced=false.
#
# 2. USE NEON'S POOLED ENDPOINT, AND KEEP THE STATEMENT CACHES OFF.
#    db/session.py detects "-pooler" in the URL and sets
#    prepared_statement_cache_size/statement_cache_size to 0. pgbouncer in
#    transaction mode does not support prepared statements and asyncpg raises
#    DuplicatePreparedStatementError without this.
#
# 3. DO NOT LOAD MODEL WEIGHTS IN THE CONTAINER.
#    Startup logs show BGE-M3 + the reranker loading from local weights (~2.3 GB,
#    ~10 s) before the app serves traffic. Vision needs neither. Set
#    MODEL_SERVICE_URL so embedding/reranking is remote.
#
# 4. CORS AND THE FAIL-FAST GUARD.
#    CORS_ORIGINS must list the deployed frontend origin; the built-in default
#    names the *development* Catalyst subdomain and will not match production.
#    Set APP_ENV=production AND a real JWT_SECRET — main.py refuses to boot on the
#    default secret in production, which is the protection you want.
#
# 5. CONTAINER PORT.
#    AppSail injects X_ZOHO_CATALYST_LISTEN_PORT (default 9000). The Dockerfile
#    honours it and falls back to 8000, so nothing changes locally.
#
# 6. WEBSOCKETS ARE UNCONFIRMED ON APPSAIL.
#    Vision treats polling as a first-class transport and shows LIVE vs POLLING
#    in the HUD, so a dropped socket degrades visibly instead of freezing the map.
#
# 7. LIVE CCTV DOES NOT RUN ON APPSAIL.
#    /api/ops/camera/start spawns an OS process needing cv2 + ultralytics and
#    opens an MJPEG port. On the deployed build the camera layer is seeded data
#    with FABRICATED field-of-view cones, labelled `simulated` in the UI.
# ============================================================================

# Overall compute plane: api | local
MODEL_BACKEND=api

# Brain engine (chat / slots / routing): gemini | groq | openai
BRAIN_ENGINE=gemini

# Text-to-SQL engine: gemini | qwen3-coder-next
SQL_ENGINE=gemini

# Voice backend: sarvam | google | bhashini
VOICE_BACKEND=sarvam

# Gemini (primary brain + default SQL engine)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq (low-latency / outage fallback brain)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (ChatGPT) — optional alternative brain engine
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1
# Hard cap on OpenAI requests per UTC day. Reserved before each call, so the cap
# cannot be overshot by concurrent requests. Past it the brain fails over to
# Gemini automatically. Set this to your key's actual RPD limit.
OPENAI_DAILY_LIMIT=50

# Sarvam (primary voice: Bulbul v3 TTS, Saaras v3 STT, Sarvam Translate)
SARVAM_API_KEY=

# Google Cloud voice (Text-to-Speech + Speech-to-Text REST, API-key auth)
# Only needed if VOICE_BACKEND=google or the Settings panel selects Google API.
GOOGLE_TTS_API_KEY=
# GOOGLE_TTS_VOICE=en-IN-Neural2-A   # optional named voice; leave blank for language-default

# Bhashini (fallback voice: govt, free, no credit cap)
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# Ollama Cloud (qwen3-coder-next Text-to-SQL option)
OLLAMA_CLOUD_URL=https://api.ollama.com
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_SQL_MODEL=qwen3-coder-next:cloud

# Embeddings (always BGE-M3 local — not configurable)
EMBEDDING_DIM=1024

# ── Local model inference ────────────────────────────────────────────────────
# Paths are relative to the backend/ working directory.
EMBEDDING_MODEL_PATH=models/bge-m3
RERANKER_MODEL_PATH=models/bge-reranker-v2-m3
# "cuda" for RTX 4070 (default), "cpu" for CPU-only fallback
MODEL_DEVICE=cuda
# Load models in FP16 (halves VRAM; 1=enabled, 0=disabled)
MODEL_FP16=1
