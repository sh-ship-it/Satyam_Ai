APP_ENV=development
# Runtime: least-privilege role so Postgres RLS is enforced (NOT the table owner).
DATABASE_URL=postgresql+asyncpg://satyam_app:satyam_app@localhost:5432/satyam
# Owner/superuser role - used ONLY for migrations + seeding.
SEED_DATABASE_URL=postgresql+asyncpg://satyam:satyam@localhost:5432/satyam
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000

# Overall compute plane: api | local
MODEL_BACKEND=api

# Brain engine (chat / slots / routing): gemini | groq
BRAIN_ENGINE=gemini

# Text-to-SQL engine: gemini | qwen3-coder-next
SQL_ENGINE=gemini

# Voice backend: sarvam | bhashini
VOICE_BACKEND=sarvam

# Gemini (primary brain + default SQL engine)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq (low-latency / outage fallback brain)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Sarvam (primary voice: Bulbul v3 TTS, Saaras v2 STT, Sarvam Translate)
SARVAM_API_KEY=

# Bhashini (fallback voice: govt, free, no credit cap)
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# Ollama Cloud (qwen3-coder-next Text-to-SQL option)
OLLAMA_CLOUD_URL=https://api.ollama.com
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_SQL_MODEL=qwen3-coder-next:cloud

# Embeddings (always BGE-M3 local — not configurable)
EMBEDDING_DIM=1024
